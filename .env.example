# Frontend Environment Variables
# In production on Vercel, set VITE_API_KEY to match APP_SECURITY_API_KEY in Spring Boot
VITE_API_KEY=portfolio-secret-token-2026

# In production, set to your hosted backend URL (e.g. https://devprofile-backend.up.railway.app)
# If empty, Vite will use relative proxy paths in local dev
VITE_API_BASE_URL=
